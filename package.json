{
  "name": "sistemakaraoke",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:firebase": "node scripts/check-firebase-env.mjs && npm run build",
    "dev:firebase-test": "vite --mode emulator",
    "test": "node --experimental-strip-types --test tests/domain.test.mjs tests/reports.test.mjs tests/youtube.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-sistema-karaoke --only firestore \"node tests/firestore.rules.test.mjs\"",
    "test:mobile": "node tests/mobile.smoke.mjs",
    "test:youtube-ui": "node tests/youtube.ui.smoke.mjs",
    "test:firebase": "firebase emulators:exec --project demo-sistema-karaoke --only auth,firestore \"node tests/firebase.smoke.mjs\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
